# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION
# Required for Firebase Authentication and Cloud Firestore database connectivity.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# CHAPA_SECRET_KEY: Required for secure Chapa payment integrations.
# Retrieve this from your Chapa merchant dashboard (e.g., CHAPASECKEY-...).
# If not supplied, the server will gracefully run in a secure, fully-featured interactive Sandbox mode.
CHAPA_SECRET_KEY=""

# MAILCHIMP_API_KEY: Required for Mailchimp marketing API.
MAILCHIMP_API_KEY=""

# MAILCHIMP_LIST_ID: Required for Mailchimp audience lists.
MAILCHIMP_LIST_ID=""

# MAILCHIMP_FROM_EMAIL: The verified email address you use to send emails in Mailchimp
MAILCHIMP_FROM_EMAIL=""

# SHIPDAY_API_KEY: Required for Shipday delivery API.
SHIPDAY_API_KEY=""

# SHIPDAY_WEBHOOK_TOKEN: Optional token to verify webhooks from Shipday.
# You can set any string here and use it in your Shipday webhook configuration.
SHIPDAY_WEBHOOK_TOKEN=""

# GOOGLE MAPS PLATFORM KEY: Required for Google Maps address autocomplete and map rendering.
GOOGLE_MAPS_PLATFORM_KEY=""
VITE_GOOGLE_MAPS_PLATFORM_KEY=""
