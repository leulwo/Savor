NODE_ENV=production
PORT=3000
APP_URL=https://your-coolify-domain
# Trust only your reverse proxy's actual network/IP. Empty trusts no forwarded IPs.
# Example after inspecting the Coolify proxy network: TRUST_PROXY_CIDRS=172.18.0.0/16
TRUST_PROXY_CIDRS=
# Local SQLite application data. Relative paths resolve against the project root.
# For Coolify mount persistent storage at /app/data and use /app/data/savory.sqlite.
DATABASE_PATH=data/savory.sqlite
# Server-only primary admin. Sign in with this Google account. Change and fully
# restart the backend to replace the previous primary; other team roles stay in SQLite.
PRIMARY_ADMIN_EMAIL=
# Optional configuration-check inputs (verification only; never credentials):
CHAPA_DASHBOARD_WEBHOOK_URL=https://your-coolify-domain/api/chapa/webhook
CHAPA_DASHBOARD_CALLBACK_URL=https://your-coolify-domain/api/chapa/callback
CHAPA_DASHBOARD_RETURN_URL=https://your-coolify-domain/?payment_return=1
FIREBASE_AUTHORIZED_DOMAINS=your-coolify-domain,your-project.firebaseapp.com
GOOGLE_OAUTH_REDIRECT_URIS=https://your-project.firebaseapp.com/__/auth/handler

# Chapa: use matching credentials from the same Test or Live mode.
CHAPA_SECRET_KEY=
# Must exactly match the webhook secret configured in Chapa Dashboard.
CHAPA_WEBHOOK_SECRET=

# Firebase remains the Google sign-in provider. Application data lives in SQLite;
# service-account credentials and Google Application Default Credentials are not needed.
FIREBASE_PROJECT_ID=

# Frontend build-time public configuration (Coolify Docker build arguments):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
GOOGLE_MAPS_PLATFORM_KEY=
VITE_GOOGLE_MAPS_PLATFORM_KEY=

GEMINI_API_KEY=
MAILCHIMP_API_KEY=
MAILCHIMP_FROM_EMAIL=
MAILCHIMP_LIST_ID=
SHIPDAY_API_KEY=
SHIPDAY_WEBHOOK_TOKEN=
