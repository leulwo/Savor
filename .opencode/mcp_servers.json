{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ast-sast-semgrep": {
      "type": "local",
      "enabled": true,
      "command": ["semgrep", "mcp", "--config", "auto"]
    },
    "secret-gitleaks": {
      "type": "local",
      "enabled": true,
      "command": ["gitleaks", "mcp", "--redact", "--detect-uncommitted"]
    },
    "secret-trufflehog": {
      "type": "local",
      "enabled": true,
      "command": ["trufflehog", "mcp", "--verify"]
    },
    "dependency-osv": {
      "type": "local",
      "enabled": true,
      "command": ["osv-scanner", "mcp", "--json"]
    },
    "iac-trivy-checkov": {
      "type": "local",
      "enabled": true,
      "command": ["checkov", "mcp", "--framework", "terraform,dockerfile,kubernetes,helm"]
    },
    "git-history": {
      "type": "local",
      "enabled": true,
      "command": ["git-mcp", "--all-branches", "--include-stashes"]
    },
    "api-schemathesis": {
      "type": "local",
      "enabled": true,
      "command": ["schemathesis", "mcp", "--checks", "all"]
    },
    {
  "mcpServers": {
    "firebase-mcp-server": {
      "command": "npx",
      "args": ["-y", "firebase-tools@latest", "mcp"]
    }
  }
}
  }
}
