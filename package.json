{
  "name": "savory",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "security:check": "node scripts/security-check.cjs",
    "dev": "npm --prefix backend run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "check:payment-config": "node scripts/check-payment-config.cjs",
    "db:status": "npm --prefix backend run db:status",
    "db:owner": "npm --prefix backend run db:owner --",
    "db:export": "npm --prefix backend run db:export --",
    "db:import": "npm --prefix backend run db:import --",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "start": "npm --prefix backend start",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint"
  }
}
