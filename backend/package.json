{
  "name": "savory-backend",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node dev.cjs",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=server.js && esbuild local-db-cli.ts --bundle --platform=node --format=cjs --packages=external --outfile=db-cli.js",
    "start": "node server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:status": "tsx local-db-cli.ts status",
    "db:owner": "tsx local-db-cli.ts owner",
    "db:export": "tsx local-db-cli.ts export",
    "db:import": "tsx local-db-cli.ts import"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
