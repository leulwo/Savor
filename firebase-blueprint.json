{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information including saved addresses and favorites.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "savedAddresses": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "favoriteItems": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Reservation": {
      "title": "Table Reservation",
      "description": "A booking for a table.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Optional user ID" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string", "format": "time" },
        "partySize": { "type": "integer" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "date", "time", "partySize", "status"]
    },
    "Review": {
      "title": "Item Review",
      "description": "A customer review and rating for a menu item.",
      "type": "object",
      "properties": {
        "menuItemId": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["menuItemId", "rating", "createdAt"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A message in a chat conversation.",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string", "description": "The unique ID of the conversation." },
        "role": { "type": "string", "enum": ["user", "model"], "description": "The role of the message author." },
        "text": { "type": "string", "description": "The content of the message." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the message was created." }
      },
      "required": ["conversationId", "role", "text", "createdAt"]
    },
    "Feedback": {
      "title": "Customer Feedback",
      "description": "Comments or reviews submitted by customers via the chatbot.",
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "The feedback content." },
        "orderId": { "type": "string", "description": "Optional order ID related to the feedback." },
        "customerName": { "type": "string", "description": "The name of the customer." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the feedback was submitted." }
      },
      "required": ["text", "customerName", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles."
    },
    "reservations/{reservationId}": {
      "schema": "Reservation",
      "description": "Collection of table reservations."
    },
    "reviews/{reviewId}": {
      "schema": "Review",
      "description": "Collection of item reviews."
    },
    "chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Collection of chatbot messages."
    },
    "feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "Collection of customer feedback."
    },
    "settings/{settingId}": {
      "description": "Global and checkout restaurant settings."
    }
  }
}
