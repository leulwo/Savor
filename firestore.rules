rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email;
    }

    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    function adminDoc() {
      return /databases/$(database)/documents/admins/$(email());
    }

    function roleDocPath() {
      return /databases/$(database)/documents/roles/$(roleOf());
    }

    function existsAdmin() {
      return signedIn()
        && emailVerified()
        && email() != null
        && exists(adminDoc());
    }

    function isAdmin() {
      return existsAdmin() && roleOf() == 'admin';
    }

    function roleOf() {
      return get(adminDoc()).data.role;
    }

    function roleDocExists() {
      return exists(roleDocPath());
    }

    function ownsUserDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Built-in default is admin only. Any other role must have its permissions
    // stored in the roles collection; otherwise it FAILS CLOSED (no permissions).
    // This ensures no staff role is implicitly granted via hardcoded fallbacks.
    function defaultRolePerm(perm) {
      return false;
    }

    // can(perm) is the single source of truth. The admin role always passes.
    // Unseeded roles fall back to their built-in defaults.
    function can(perm) {
      return existsAdmin()
          && (roleOf() == 'admin'
              || (roleDocExists() ? get(roleDocPath()).data.permissions[perm] == true : defaultRolePerm(perm)));
    }

    // True only when the update touches pricing fields and nothing else.
    function onlyPriceFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'price', 'basePrice'
      ]);
    }

    // True only when the update toggles dish availability and nothing else.
    function onlyAvailabilityFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['variations']);
    }

    // True only when the update changes the item's display/content fields and
    // nothing else. Excludes price, availability and category assignment so the
    // menu.edit permission can never overlap menu.editPrice /
    // menu.editAvailability / menu.categories.
    function onlyContentFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'id', 'name', 'description', 'promoStickers',
        'image', 'galleryImages', 'popular', 'ingredients', 'nutrition',
        'menuTiming', 'timingFrom', 'timingTo'
      ]);
    }

    // True only when the update changes which categories the item belongs to and
    // nothing else.
    function onlyCategoryFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category', 'categories']);
    }

    // ---- Order field-scoping helpers ----
    // True only when the update changes the order's `status` field (and nothing
    // else), so an order permission can never rewrite the whole order doc.
    function onlyStatusFieldChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    function onlyPaymentFieldChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus']);
    }

    // True when status transitions exactly from -> to.
    function statusTransition(from, to) {
      return resource.data.status == from && request.resource.data.status == to;
    }

    match /menu/{documentId} {
      allow read: if true;
      allow create: if can('menu.create');
      // Strict separation in Menu: each permission can change ONLY its own
      // fields.
      //   menu.edit             -> content fields only
      //   menu.editPrice        -> pricing fields only
      //   menu.editAvailability -> availability flags only
      //   menu.categories       -> category assignment only
      // No permission implicitly implies another: menu.edit cannot change
      // price, availability or categories; menu.editPrice cannot change
      // content/availability/categories; etc.
      allow update: if (can('menu.edit') && onlyContentFieldsChanged())
          || (can('menu.editPrice') && onlyPriceFieldsChanged())
          || (can('menu.editAvailability') && onlyAvailabilityFieldsChanged())
          || (can('menu.categories') && onlyCategoryFieldsChanged());
      allow delete: if can('menu.delete');
    }

    match /categories/{documentId} {
      allow read: if true;
      allow create, update, delete: if can('menu.categories');
    }

    match /promoCodes/{documentId} {
      allow get: if can('promos.view');
      allow list: if can('promos.view');
      allow write: if can('promos.manage');
    }

    match /roles/{roleId} {
      allow read: if existsAdmin();
      allow create, update, delete: if can('roles.edit') || roleOf() == 'admin';
    }

    match /admins/{email} {
      allow get: if existsAdmin() || (signedIn() && request.auth.token.email == email);
      allow list: if can('team.view');
      allow create, update: if can('team.invite') || can('roles.edit');
      allow delete: if can('team.remove') || can('roles.edit');
    }

    match /users/{userId} {
      allow read: if ownsUserDocument(userId) || isAdmin() || can('customers.view');
      allow create, delete: if ownsUserDocument(userId) || isAdmin();
      allow update: if ownsUserDocument(userId) || isAdmin();
    }

    match /carts/{userId} {
      allow read, create, update, delete: if ownsUserDocument(userId);
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin() || can('orders.view') || can('kds.view') || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      // Order permissions are field-scoped: each may change ONLY its own field.
      //   orders.updateStatus -> status (any non-cancel transition)
      //   orders.cancel       -> status pending -> cancelled
      //   orders.markPaid     -> paymentStatus only
      //   kds.startPreparing  -> status pending -> preparing
      //   kds.markReady       -> status preparing -> ready
      // No permission can rewrite the whole order or toggle another permission's field.
      allow update: if isAdmin()
          || (can('orders.updateStatus') && onlyStatusFieldChanged() && request.resource.data.status != 'cancelled')
          || (can('orders.cancel') && onlyStatusFieldChanged() && statusTransition('pending', 'cancelled'))
          || (can('orders.markPaid') && onlyPaymentFieldChanged())
          || (can('kds.startPreparing') && onlyStatusFieldChanged() && statusTransition('pending', 'preparing'))
          || (can('kds.markReady') && onlyStatusFieldChanged() && statusTransition('preparing', 'ready'))
          || (signedIn() && resource.data.userId == request.auth.uid && onlyStatusFieldChanged() && statusTransition('pending', 'cancelled'));
      allow delete: if isAdmin();
    }

    match /reservations/{reservationId} {
      allow read: if isAdmin() || can('reservations.view');
      allow create: if signedIn();
      allow update, delete: if isAdmin() || can('reservations.manage');
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /chat_messages/{messageId} {
      allow read: if isAdmin() || can('chat.view');
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow write: if isAdmin() || can('chat.reply');
    }

    match /settings/{settingId} {
      allow get: if settingId == 'global' || isAdmin() || can('settings.view');
      allow list: if isAdmin() || can('settings.view');
      allow write: if isAdmin() || can('settings.edit');
    }

    match /audit_log/{logId} {
      allow read: if isAdmin() || can('audit.view');
      allow create: if existsAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}