rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SQLite and the authenticated backend are authoritative. The application
    // no longer reads or writes Firestore business data from the browser.
    // Prepare these rules locally; deploy only on an explicit deployment request.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
